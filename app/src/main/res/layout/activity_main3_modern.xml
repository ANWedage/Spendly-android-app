<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/modern_gradient_background"
    tools:context=".MainActivity3">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Logo Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="48dp"
            app:cardBackgroundColor="@color/ic_launcher_background"
            app:cardCornerRadius="100dp"
            app:cardElevation="16dp">

            <ImageView
                android:id="@+id/logo3"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/logo" />

        </androidx.cardview.widget.CardView>

        <!-- Welcome Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Welcome to Spendly!"
            android:textColor="@color/text_inverse"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="Your personal expense tracker\nStart managing your finances smartly"
            android:textColor="@color/text_inverse"
            android:textSize="18sp"
            android:alpha="0.9"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Feature Illustration -->

        <!-- Get Started Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button2"
            android:layout_width="280dp"
            android:layout_height="60dp"
            android:text="Get Started"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            app:cornerRadius="30dp"
            app:icon="@drawable/ic_home"
            app:iconTint="@color/primary"
            app:elevation="8dp" />

        <!-- Skip Option -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
