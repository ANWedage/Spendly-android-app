<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Spendly" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_inverse</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/text_inverse</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Other colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_inverse</item>

        <!-- Material Design 3 specific -->
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
    </style>

    <style name="Theme.Spendly" parent="Base.Theme.Spendly" />

    <!-- Modern Button Styles -->
    <style name="ModernButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ModernButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_inverse</item>
    </style>

    <style name="ModernButton.Secondary">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/text_inverse</item>
    </style>

    <style name="ModernButton.Danger">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/text_inverse</item>
    </style>

    <!-- Modern Card Style -->
    <style name="ModernCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <!-- Modern Text Styles -->
    <style name="ModernText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ModernText.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="ModernText.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ModernText.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="ModernText.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
</resources>